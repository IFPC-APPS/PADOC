# PADOC — modèle de configuration
# Copier en .env : cp .env.example .env  (docker compose le lit automatiquement)

# ── PostgreSQL ───────────────────────────────────────────────────────────────
PGDATABASE=ifpc
PGUSER=ifpc
# Renseigner une valeur propre à cet environnement, ne jamais la committer.
PGPASSWORD=
PGPORT=5432
# En production (Railway), PGHOST est fourni par le service managé.
# En local via Compose, il vaut « db » (nom du service).

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Clé HS256 encodée en Base64, PARTAGÉE entre le Core API (Spring) et le
# Calc Engine (FastAPI). Générer une valeur propre à chaque environnement :
#   openssl rand -base64 48
JWT_SECRET=
# Aucune valeur par défaut : la variable doit être renseignée avant tout démarrage.

# ── Compte administrateur initial ────────────────────────────────────────────
# Créé au premier démarrage UNIQUEMENT si le compte n'existe pas déjà.
# Laisser PADOC_ADMIN_PASSWORD vide : le mot de passe est alors tiré au hasard
# et affiché une seule fois dans le journal de démarrage.
PADOC_ADMIN_EMAIL=admin@ifpc.com
PADOC_ADMIN_PASSWORD=

# ── Cloisonnement des données ────────────────────────────────────────────────
# Compte qui hérite des lots et cuves antérieurs au cloisonnement multi-tenant,
# lorsque ni le journal des opérations ni les stockages ne permettent de
# retrouver leur propriétaire d'origine.
PADOC_LEGACY_OWNER_EMAIL=admin@ifpc.com

# ── Fédération d'identité (spec docs/federation-identite.md) ─────────────────
# IFPC fournit une authentification aux plateformes partenaires : un compte créé
# ici y ouvre l'accès sans recréer d'identifiants.
#
# Laisser FEDERATION_CLIENT_ID vide garde la fédération en sommeil : les points
# d'entrée OIDC répondent, aucune plateforme n'est autorisée. Un client déclaré
# par défaut dans le dépôt serait un accès public.

# Origines autorisées à appeler l'API, séparées par des virgules.
#
# LAISSER VIDE sauf besoin explicite : à défaut de valeur, toutes les origines
# sont acceptées. Un défaut restreint a coupé l'authentification en production
# le 30/09/2026 — l'API s'authentifie par jeton d'en-tête et non par cookie,
# une origine tierce n'obtient donc rien de plus qu'un appel anonyme.
CORS_ALLOWED_ORIGINS=

# URL publique du service. C'est le claim « iss » des jetons et la racine du
# JWKS que les partenaires vérifieront. À définir en production : sinon elle est
# déduite de chaque requête, donc dictée par l'en-tête Host.
FEDERATION_ISSUER=http://localhost:8080

# La plateforme partenaire.
FEDERATION_CLIENT_ID=
FEDERATION_CLIENT_NOM=Analyse sensorielle
# Vide  ⇒ client public : application de navigateur, PKCE seul (un secret livré
#          au navigateur n'est pas un secret).
# Rempli ⇒ client confidentiel : le code s'échange de serveur à serveur.
#          À privilégier quand la plateforme a un backend.
FEDERATION_CLIENT_SECRET=
# Correspondance EXACTE, séparées par des virgules. Jamais de joker : un motif
# trop large permet de détourner la redirection vers un domaine tenu par un
# attaquant, avec un code d'autorisation valide.
FEDERATION_CLIENT_REDIRECT_URIS=
FEDERATION_CLIENT_POST_LOGOUT_URIS=
# Rôles de la plateforme accordés d'office aux administrateurs PADOC, séparés
# par des virgules. Défaut du docker-compose : « animateur » (CiderScope).
FEDERATION_CLIENT_ROLES_ADMIN=animateur

# ── Envoi d'e-mails (Resend) ─────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=service-informatique@ifpc.eu
RESEND_ADMIN_EMAIL=service-informatique@ifpc.eu

# ── URLs des backends (build frontend) ───────────────────────────────────────
# Hors Compose uniquement : Compose passe ces valeurs en build args.
SPRING_URL=http://localhost:8080
FASTAPI_URL=http://localhost:8000
