# ─────────────────────────────────────────────────────────────────────────────
#  AscoCID — configuration d'accès
#
#  1. cp .env.example .env
#  2. chmod 600 .env
#  3. remplir UNIQUEMENT le bloc correspondant à ton mode d'authentification
#
#  .env est dans .gitignore. Ne jamais coller ces valeurs dans un chat,
#  un ticket, un commit ou un message.
# ─────────────────────────────────────────────────────────────────────────────

# URL racine du référentiel (page d'entrée, le « tableau »)
ASCOCID_ROOT_URL=

# Préfixe(s) autorisés pour le crawl, séparés par des virgules.
# Vide = déduit de ASCOCID_ROOT_URL. Rien hors de ces préfixes ne sera visité.
ASCOCID_SCOPE=

# Mode d'authentification :
#   none | basic | bearer | header | cookie | form | mtls
ASCOCID_AUTH=none


# ── basic ────────────────────────────────────────────────── HTTP Basic / Digest
ASCOCID_USER=
ASCOCID_PASSWORD=


# ── bearer ─────────────────────────────────────────── jeton porteur / clé d'API
# Envoyé tel quel dans « Authorization: Bearer <token> »
ASCOCID_TOKEN=


# ── header ──────────────────────────── en-tête arbitraire (clé d'API maison)
ASCOCID_HEADER_NAME=
ASCOCID_HEADER_VALUE=


# ── cookie ─────────────────────────── session récupérée depuis le navigateur
# LE MODE À UTILISER SI ASCOCID EST DERRIÈRE UN SSO (SAML / ADFS / Azure AD).
#
# Comment l'obtenir :
#   1. se connecter normalement à AscoCID dans le navigateur
#   2. F12 → onglet « Réseau » → recharger la page
#   3. cliquer sur la 1re requête → « En-têtes de requête » → copier la
#      valeur COMPLÈTE de l'en-tête « Cookie »
#
# Attention : cette session expire (souvent 8 h à quelques jours). Si le crawl
# s'arrête sur des 302 vers la page de connexion, il faut la renouveler.
ASCOCID_COOKIE=


# ── form ──────────────────────────── formulaire de connexion → cookie de session
# Réutilise ASCOCID_USER / ASCOCID_PASSWORD du bloc « basic » ci-dessus.
ASCOCID_LOGIN_URL=
# Noms des champs du formulaire (à lire dans le HTML de la page de connexion)
ASCOCID_FORM_USER_FIELD=username
ASCOCID_FORM_PASSWORD_FIELD=password
# Champs supplémentaires éventuels, format JSON : {"domain": "ACME"}
ASCOCID_FORM_EXTRA={}


# ── mtls ───────────────────────────────────────── certificat client (mutual TLS)
ASCOCID_CLIENT_CERT=
ASCOCID_CLIENT_KEY=


# ── réseau ───────────────────────────────────────────────────────────────────
# Autorité de certification interne, si le certificat du site n'est pas public
ASCOCID_CA_BUNDLE=
# Mettre à 0 UNIQUEMENT en dernier recours, sur un réseau interne de confiance
ASCOCID_VERIFY_TLS=1
ASCOCID_PROXY=
ASCOCID_USER_AGENT=ascocid-probe/0.1 (analyse interne du referentiel qualite)
ASCOCID_TIMEOUT=30
ASCOCID_CONCURRENCE=4
ASCOCID_DELAI_MS=200


# ── modèle de génération ─────────────────────────────────────────────────────
# Clé API Claude, pour la rédaction des réponses.
# Sans elle, `./ask --sources-seules` fonctionne (recherche uniquement).
# À obtenir sur console.anthropic.com. Ne jamais la coller ailleurs que dans .env.
ANTHROPIC_API_KEY=

# Génération via Gemini (alternative à ANTHROPIC_API_KEY).
# ⚠️ Gemini n'a pas de citations natives : les marqueurs [Sn] sont demandés dans
# le prompt et contrôlés par application/requete/verification.py.
GEMINI_API_KEY=
GEMINI_MODELE=gemini-3.8-flash
GEMINI_MODELE_ANALYSE=gemini-3.1-flash-lite

# Génération via ARGO (INRAE) — le fournisseur retenu par défaut.
# Un RAG transmet au modèle les PASSAGES du corpus, pas seulement la question :
# le choix du fournisseur décide donc où part le Livre de Connaissances. ARGO le
# garde dans l'établissement. Clé à demander sur chatbot.argo.inrae.fr.
ARGO_API_KEY=
ARGO_BASE_URL=https://chatbot.argo.inrae.fr/api
# Rédaction : le grand modèle. Analyse : le petit suffit pour un étiquetage.
ARGO_MODELE=chat-gpt-oss-120b
ARGO_MODELE_ANALYSE=chat-gpt-oss-20b

# Fournisseur imposé : « argo » ou « gemini ». Laissé vide, ARGO est choisi si sa
# clé est présente, sinon Gemini. Un réglage explicite prime toujours.
LDC_FOURNISSEUR=


# ── service HTTP (./serve) ───────────────────────────────────────────────────
# Base SQLite servie par l'API (défaut : data/ascocid.sqlite)
ASCOCID_SQLITE=

# Jeton de la plateforme. Renseigné = les routes /ask et /feedback exigent un
# JWT valide (même clé que le Core API Spring Boot, base64). Non renseigné =
# service ouvert, ce que le démarrage annonce dans le journal. Chaque question
# coûte un appel payant au modèle : ne pas laisser une instance publique sans clé.
JWT_SECRET=
# Échappatoire de développement : LDC_AUTH=0 désactive la vérification même
# lorsque JWT_SECRET est défini.
LDC_AUTH=
# Origines autorisées pour CORS, séparées par des virgules (défaut : *).
# En production, le front passe par son propre proxy : une seule origine suffit.
LDC_ORIGINES=
# Interface d'écoute (défaut 127.0.0.1 ; 0.0.0.0 pour un conteneur)
LDC_HOST=
